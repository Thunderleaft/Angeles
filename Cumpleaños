<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>¡Feliz Cumpleaños Ángeles!</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Montserrat:wght@300;500&display=swap" rel="stylesheet">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: linear-gradient(135deg, #2e0854, #4a154b, #6b21a8);
      font-family: 'Montserrat', sans-serif;
      color: #ffffff;
      padding: 20px;
      text-align: center;
    }

    .container {
      background: rgba(255, 255, 255, 0.07);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      padding: 40px 20px;
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
      max-width: 700px;
      width: 100%;
    }

    h1 {
      font-family: 'Great Vibes', cursive;
      font-size: clamp(3rem, 8vw, 5.5rem);
      color: #d8b4fe; /* Morado claro / Lila brillante */
      text-shadow: 0 0 15px rgba(216, 180, 254, 0.6),
                   0 0 30px rgba(168, 85, 247, 0.4);
      margin-bottom: 20px;
      line-height: 1.2;
    }

    p.subtitulo {
      font-size: 1.1rem;
      color: #f3e8ff;
      margin-bottom: 30px;
      font-weight: 300;
      letter-spacing: 1px;
    }

    .video-container {
      width: 100%;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
      border: 2px solid rgba(216, 180, 254, 0.3);
      background-color: #000;
    }

    video {
      width: 100%;
      height: auto;
      display: block;
    }
  </style>
</head>
<body>

  <div class="container">
    <h1>¡Feliz Cumpleaños Ángeles!</h1>
    <p class="subtitulo">Un detalle especial en tu día</p>
    
    <div class="video-container">
      <video controls poster="https://via.placeholder.com/800x450/4a154b/ffffff?text=Haz+clic+para+reproducir">
        <source src="tu-video.mp4" type="video/mp4">
        Tu navegador no soporta la reproducción de video.
      </video>
    </div>
  </div>

</body>
</html>
